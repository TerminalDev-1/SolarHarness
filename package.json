{
  "name": "solar-harness",
  "private": true,
  "type": "module",
  "bin": {
    "solar": "./dist/index.js",
    "solar-harness": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
