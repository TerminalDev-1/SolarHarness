  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "ink": "^6.8.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.2",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
